# Copy to .env. Never commit real tokens.
HOST=127.0.0.1
PORT=8765
PUBLIC_URL=http://127.0.0.1:8765
COOKIE_SECURE=false
TEAM_TIMEZONE=Asia/Shanghai
# DATA_DIR=./data

# Optional Telegram integration. Run ONE bot worker per database.
TELEGRAM_BOT_TOKEN=
# Optional proxy, e.g. http://127.0.0.1:7890
TELEGRAM_PROXY_URL=

# Optional Feishu / Lark self-built app. Run ONE Feishu worker per database.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# feishu (default, open.feishu.cn), lark (open.larksuite.com), or custom https:// domain
FEISHU_DOMAIN=feishu
# Set true (with COOKIE_SECURE=true over HTTPS) to allow embedding in Feishu Workbench / Docs
FEISHU_EMBED=false
# Optional custom space-separated https:// frame-ancestors allowlist
# FEISHU_FRAME_ANCESTORS=
# Optional cookie SameSite override (lax / strict / none; none requires COOKIE_SECURE=true)
# COOKIE_SAMESITE=lax

# AI natural-language bookkeeping is configured directly in Web ("机器人与 AI").
# No AI_* environment variables are required.

# Daily reference exchange rates. No API key needed.
FX_API_URL=https://api.frankfurter.app/latest
FX_CACHE_HOURS=12

# Full backup ZIP upload/download limit (default: 256 MiB).
# Configure local / WebDAV / S3 and automatic schedules in Team settings.
BACKUP_MAX_BYTES=268435456
