# Copy to .env. Never commit real tokens or secrets.
HOST=127.0.0.1
PORT=8765
PUBLIC_URL=http://127.0.0.1:8765
COOKIE_SECURE=false
TEAM_TIMEZONE=Asia/Shanghai
# DATA_DIR=./data

# Vanora OAuth (OpenID Connect) — required for Web sign-in & centralized permissions.
# Provision with Vanora-oauth's configure-vanora.py --team-ledger-url <PUBLIC_URL>
# (confidential OIDC client with PKCE S256, client roles owner/finance/member,
# resource_access.<client_id>.roles ID Token mapper, and vanora.permissions.sync.enabled=true):
#   Valid redirect URI:     <PUBLIC_URL>/api/auth/oidc/callback
#   Backchannel logout URL: <PUBLIC_URL>/api/auth/oidc/backchannel-logout
VANORA_OIDC_ISSUER=
VANORA_OIDC_CLIENT_ID=
VANORA_OIDC_CLIENT_SECRET=
# Optional secret file (takes precedence if VANORA_OIDC_CLIENT_SECRET is empty)
# VANORA_OIDC_CLIENT_SECRET_FILE=
# Optional OIDC scopes (default: openid profile email)
# VANORA_OIDC_SCOPES=openid profile email
# Optional Vanora Admin Console URL shown to owners on the read-only Members page
# VANORA_OIDC_ADMIN_URL=
# Optional permission sync cache TTL in seconds (default: 30; 0 disables background TTL polling)
# VANORA_OIDC_PERMISSIONS_TTL=30
# Optional custom dot-separated roles claim path (default: resource_access.<client_id>.roles)
# VANORA_OIDC_ROLES_CLAIM=
# Optional required ACR level (e.g. 2 to require TOTP/MFA LoA 2; leave empty for all Vanora login methods)
# VANORA_OIDC_ACR_VALUES=
# Optional internal Vanora realm base URL for server-side discovery/token/JWKS/permission-sync calls
# VANORA_OIDC_INTERNAL_URL=
# Optional PEM CA bundle for private/local HTTPS Vanora OAuth instances
# VANORA_OIDC_CA_FILE=
# Set true only if Valid post logout redirect URIs is configured on the Vanora OIDC client
# VANORA_OIDC_END_SESSION=false

# Optional Telegram integration. Run ONE bot worker per database.
TELEGRAM_BOT_TOKEN=
# Optional proxy, e.g. http://127.0.0.1:7890
TELEGRAM_PROXY_URL=

# Optional Feishu / Lark self-built app. Run ONE Feishu worker per database.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# feishu (default, open.feishu.cn), lark (open.larksuite.com), or custom https:// domain
FEISHU_DOMAIN=feishu
# Set true (with COOKIE_SECURE=true over HTTPS) to allow embedding in Feishu Workbench / Docs
FEISHU_EMBED=false
# Optional custom space-separated https:// frame-ancestors allowlist
# FEISHU_FRAME_ANCESTORS=
# Optional cookie SameSite override (lax / strict / none; none requires COOKIE_SECURE=true)
# COOKIE_SAMESITE=lax

# AI natural-language bookkeeping is configured directly in Web ("机器人与 AI").
# No AI_* environment variables are required.

# Daily reference exchange rates. No API key needed.
FX_API_URL=https://api.frankfurter.app/latest
FX_CACHE_HOURS=12

# Full backup ZIP upload/download limit (default: 256 MiB).
# Configure local / WebDAV / S3 and automatic schedules in Team settings.
BACKUP_MAX_BYTES=268435456
